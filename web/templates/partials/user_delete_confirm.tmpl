{{define "user_delete_confirm"}}
<div class="modal-header bg-danger text-white">
    <h5 class="modal-title" id="deleteUserModalLabel">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete User
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form hx-delete="/gui/users/{{.ID}}"
      hx-target="#delete-user-modal-body"
      hx-swap="innerHTML">
    <div class="modal-body">
        <div class="alert alert-warning small mb-3">
            <strong><i class="bi bi-exclamation-circle me-1"></i>Warning:</strong>
            This action is irreversible and will:
            <ul class="mb-0 mt-2">
                <li>Delete the user account and all associated data</li>
                <li>Revoke all active sessions immediately</li>
                <li>Remove the user from all organizations — their memberships will be cleaned up</li>
                <li>Archive a pseudonymous record for audit purposes (GDPR-compliant)</li>
            </ul>
        </div>

        <div class="card bg-light border mb-3">
            <div class="card-body py-2 px-3">
                <div class="row g-2 small">
                    <div class="col-4 text-muted">User:</div>
                    <div class="col-8 fw-semibold">{{.Email}}</div>
                    {{if .Name}}
                    <div class="col-4 text-muted">Name:</div>
                    <div class="col-8">{{.Name}}</div>
                    {{end}}
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold">
                Type the user's email to confirm deletion:
            </label>
            <input type="text" name="confirm_email" class="form-control"
                   placeholder="{{.Email}}" required autocomplete="off">
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold">Archive Mode:</label>
            <select name="archive_mode" class="form-select form-select-sm">
                <option value="purge" selected>Purge — GDPR-compliant (anonymize all personal data)</option>
                <option value="archive">Archive — preserve full profile data for audit</option>
            </select>
            <div class="form-text small">
                <strong>Purge</strong> replaces email/name with anonymous values.
                <strong>Archive</strong> keeps the full profile for audit trails.
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Delete User Permanently
        </button>
    </div>
</form>
{{end}}
